# ===========================================================================
# Sure26 self-host settings — copy to ".env" and fill in the two REQUIRED
# secrets below. Never commit your real .env (it is git-ignored).
#
#   cp .env.sure26.example .env
#
# Used by: docker compose -f compose.sure26.yml ...
# ===========================================================================

# --- REQUIRED secrets -------------------------------------------------------

# A long random string that signs sessions/cookies. Generate ONE and keep it
# stable (changing it logs everyone out). Create with:
#   openssl rand -hex 64
SECRET_KEY_BASE=

# Your database password. Choose a strong value. Generate with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- AGPL source availability (recommended) ---------------------------------

# Your published fork, so the in-app "source" link points at your code.
SURE_SOURCE_REPO=aso42244/sure26

# The exact commit you build/deploy, so the link resolves to that source.
# Set with:  BUILD_COMMIT_SHA=$(git rev-parse HEAD)
BUILD_COMMIT_SHA=

# --- Optional tweaks --------------------------------------------------------

# Host port the app is served on (http://<your-server>:PORT). Default 3000.
PORT=3000

# Database user / name (defaults are fine for a fresh install).
POSTGRES_USER=sure_user
POSTGRES_DB=sure_production

# Where automated backups are written on the host (used by the backup profile).
BACKUP_DIR=./backups

# Optional AI features. Leave blank to keep them off (they cost money if on).
OPENAI_ACCESS_TOKEN=

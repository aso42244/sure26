<%# locals: (budget_category:) %>

<% currency = Money::Currency.new(budget_category.budget.currency) %>

<div id="<%= dom_id(budget_category, :form) %>" class="w-full flex gap-3">
  <div class="w-1 h-3 rounded-xl mt-1" style="background-color: <%= budget_category.category.color %>"></div>

  <div class="text-sm mr-3">
    <p class="text-primary font-medium mb-0.5"><%= budget_category.category.display_name %></p>

    <p class="text-secondary privacy-sensitive"><%= t("budget_categories.budget_category_form.monthly_average", amount: budget_category.median_monthly_expense_money.format(precision: 0)) %></p>
  </div>

  <div class="ml-auto">
    <% if budget_category.folder? %>
      <%# A folder has no budget of its own; nothing to edit here. %>
      <p class="text-xs text-subdued pt-2 whitespace-nowrap"><%= t("budget_categories.budget_category_form.folder_note") %></p>
    <% else %>
    <%= form_with model: [budget_category.budget, budget_category], data: { controller: "auto-submit-form preserve-focus" } do |f| %>
      <div class="flex items-start gap-3">
        <div class="form-field w-[120px]">
          <div class="flex items-center privacy-sensitive privacy-sensitive-interactive">
            <span class="text-secondary text-sm mr-2"><%= currency.symbol %></span>
            <%= f.number_field :budgeted_spending,
                              class: "form-field__input text-right [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none",
                              placeholder: budget_category.subcategory? ? t("budget_categories.budget_category_form.shared_placeholder") : "0",
                              step: currency.step,
                              id: dom_id(budget_category, :budgeted_spending),
                              min: 0,
                              data: { auto_submit_form_target: "auto" },
                              title: budget_category.subcategory? ? t("budget_categories.budget_category_form.shared_title") : nil %>
          </div>

        </div>

        <% rollover_title = budget_category.inherits_parent_budget? ? t("budget_categories.budget_category_form.rollover_title_shared") : t("budget_categories.budget_category_form.rollover_title") %>
        <label class="flex items-center gap-1.5 text-xs text-secondary pt-2" title="<%= rollover_title %>">
          <%= f.check_box :rollover_enabled,
                          class: "checkbox",
                          data: { auto_submit_form_target: "auto" } %>
          <%= t("budget_categories.budget_category_form.rollover_label") %>
        </label>
      </div>
    <% end %>

    <%# The running balance is editable in its own form: typing a number sets
        the balance to exactly that, absorbing the difference so an envelope can
        be seeded with what it really holds. Separate from the form above so
        each field posts only itself. %>
    <% if (balance = budget_category.rollover_balance_money) %>
      <%= form_with model: [budget_category.budget, budget_category], data: { controller: "auto-submit-form" } do |bf| %>
        <div class="flex items-center justify-end gap-1 mt-1">
          <%= bf.label :rollover_balance, t("budget_categories.budget_category_form.rollover_balance_label"),
                       class: "text-xs text-secondary" %>
          <div class="flex items-center privacy-sensitive privacy-sensitive-interactive">
            <span class="text-secondary text-xs mr-1"><%= currency.symbol %></span>
            <%= bf.number_field :rollover_balance,
                                value: balance.amount,
                                class: "form-field__input text-right text-xs w-[70px] [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none",
                                step: currency.step,
                                id: dom_id(budget_category, :rollover_balance),
                                data: { auto_submit_form_target: "auto" },
                                title: t("budget_categories.budget_category_form.rollover_balance_title") %>
          </div>
        </div>
      <% end %>
    <% end %>
    <% end %>
  </div>
</div>

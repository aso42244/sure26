<%
  # Eligible endpoints: top-level categories and subcategories with their own
  # individual limit. Subcategory labels are prefixed with the parent name so
  # duplicate child names stay distinguishable.
  category_items = @transferable_budget_categories.sort_by { |bc| bc.category.name.to_s }.map do |bc|
    label = if bc.subcategory? && bc.parent_budget_category
      "#{bc.parent_budget_category.category.name} / #{bc.category.name}"
    else
      bc.category.name
    end
    { value: bc.category_id, label: label, object: bc.category }
  end
%>

<%= render DS::Dialog.new(width: :sm) do |dialog| %>
  <% dialog.with_header(title: t(".title"), subtitle: t(".subtitle")) %>
  <% dialog.with_body do %>
    <% if category_items.size < 2 %>
      <p class="text-secondary text-sm px-1"><%= t(".not_enough_categories") %></p>
    <% else %>
      <%= form_with url: budget_budget_category_transfers_path(@budget), scope: :budget_category_transfer, method: :post do |f| %>
        <div class="space-y-4">
          <div class="space-y-1">
            <%= f.label :from_category_id, t(".from_label"), class: "text-sm text-secondary" %>
            <%= render DS::Select.new(
                  form: f,
                  method: :from_category_id,
                  items: category_items,
                  variant: :badge,
                  include_blank: t(".select_placeholder")
                ) %>
          </div>

          <div class="space-y-1">
            <%= f.label :to_category_id, t(".to_label"), class: "text-sm text-secondary" %>
            <%= render DS::Select.new(
                  form: f,
                  method: :to_category_id,
                  items: category_items,
                  variant: :badge,
                  include_blank: t(".select_placeholder")
                ) %>
          </div>

          <div class="space-y-1">
            <%= f.label :amount, t(".amount_label"), class: "text-sm text-secondary" %>
            <div class="form-field flex items-center privacy-sensitive">
              <span class="text-secondary text-sm mr-2"><%= Money::Currency.new(@budget.currency).symbol %></span>
              <%= f.number_field :amount,
                    class: "form-field__input [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none",
                    placeholder: "0",
                    step: Money::Currency.new(@budget.currency).step,
                    min: 0,
                    required: true %>
            </div>
          </div>

          <p class="text-xs text-secondary"><%= t(".hint") %></p>

          <div class="flex justify-end gap-2 pt-2">
            <%= render DS::Button.new(text: t(".cancel"), variant: :outline, type: "button", data: { action: "DS--dialog#close" }) %>
            <%= render DS::Button.new(text: t(".submit"), type: "submit") %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
